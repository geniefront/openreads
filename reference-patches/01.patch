diff --git a/test/page_count_filter_test.dart b/test/page_count_filter_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..1d81c9abcf8c6405baabaa7eeaa41551c4d0e50e
--- /dev/null
+++ b/test/page_count_filter_test.dart
@@ -0,0 +1,27 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:openreads/core/helpers/page_count_filter.dart';
+import 'package:openreads/logic/bloc/sort_bloc/sort_state.dart';
+
+void main() {
+  test('includes the 200-page boundary but excludes unknown page counts', () {
+    expect([null, 0, 1, 200, 201].where((n) => matchesPageLimit(n, true)),
+        [1, 200]);
+    expect(matchesPageLimit(null, false), isTrue);
+  });
+
+  test('older sort state loads with the filter off and new state round-trips',
+      () {
+    final old = {
+      'sort_type': 0,
+      'sort_order': true,
+      'only_favourite': false,
+      'filter_tags_as_and': false,
+      'filter_out_tags': false,
+    };
+    final state = SortState.fromJson(old);
+    expect(state.shortBooksOnly, isFalse);
+    final enabled = state.copyWith(shortBooksOnly: true);
+    expect(enabled, isNot(state));
+    expect(SortState.fromJson(enabled.toJson()!), enabled);
+  });
+}
