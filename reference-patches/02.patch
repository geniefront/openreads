diff --git a/lib/ui/settings_screen/widgets/merge_book_tags_dialog.dart b/lib/ui/settings_screen/widgets/merge_book_tags_dialog.dart
new file mode 100644
index 0000000000000000000000000000000000000000..627e02fe665b3209264e4bb155b54c145eef7dd1
--- /dev/null
+++ b/lib/ui/settings_screen/widgets/merge_book_tags_dialog.dart
@@ -0,0 +1,125 @@
+import 'package:flutter/material.dart';
+import 'package:openreads/core/helpers/merge_book_tags.dart';
+import 'package:openreads/main.dart';
+import 'package:openreads/model/book.dart';
+
+class MergeBookTagsDialog extends StatefulWidget {
+  const MergeBookTagsDialog({super.key});
+
+  @override
+  State<MergeBookTagsDialog> createState() => _MergeBookTagsDialogState();
+}
+
+class _MergeBookTagsDialogState extends State<MergeBookTagsDialog> {
+  String? _from;
+  String? _into;
+  bool _saving = false;
+  String? _error;
+
+  Future<void> _merge(Set<int> ids) async {
+    setState(() {
+      _saving = true;
+      _error = null;
+    });
+    try {
+      final changed = await bookCubit.mergeTags(_from!, _into!, ids);
+      if (mounted) Navigator.of(context).pop(changed);
+    } on StateError {
+      if (mounted) {
+        setState(() {
+          _saving = false;
+          _error = 'The library changed. Close and reopen this preview.';
+        });
+      }
+    } catch (_) {
+      if (mounted) {
+        setState(() {
+          _saving = false;
+          _error = 'The merge could not be saved. Check the library and retry.';
+        });
+      }
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return StreamBuilder<List<Book>>(
+      stream: bookCubit.allBooks,
+      builder: (context, snapshot) {
+        final books = snapshot.data ?? const <Book>[];
+        final tags = books
+            .expand((book) => bookTagNames(book.tags))
+            .where((tag) => tag.trim().isNotEmpty)
+            .toSet()
+            .toList()
+          ..sort();
+        final ids = books
+            .where((book) => bookTagNames(book.tags).contains(_from))
+            .map((book) => book.id)
+            .whereType<int>()
+            .toSet();
+        final ready = !_saving && tags.contains(_into) &&
+            _from != _into && ids.isNotEmpty;
+        return PopScope(
+          canPop: !_saving,
+          child: AlertDialog(
+            title: const Text('Merge book tags'),
+            scrollable: true,
+            content: Column(
+              mainAxisSize: MainAxisSize.min,
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                if (tags.length < 2)
+                  const Text('Add two different book tags to use this action.'),
+                if (tags.length >= 2) ...[
+                  _tagPicker('From tag', _from, tags, (value) {
+                    setState(() {
+                      _from = value;
+                      if (_from == _into) _into = null;
+                    });
+                  }),
+                  _tagPicker('Keep tag', _into,
+                      tags.where((tag) => tag != _from).toList(), (value) {
+                    setState(() => _into = value);
+                  }),
+                  if (_from != null && _into != null)
+                    Text('${ids.length} book(s) will use "$_into" instead of "$_from".'),
+                ],
+                if (_error != null) Text(_error!),
+              ],
+            ),
+            actions: [
+              TextButton(
+                onPressed: _saving ? null : () => Navigator.of(context).pop(),
+                child: const Text('Cancel'),
+              ),
+              FilledButton(
+                onPressed: ready ? () => _merge(ids) : null,
+                child: Text(_saving ? 'Saving…' : 'Merge tags'),
+              ),
+            ],
+          ),
+        );
+      },
+    );
+  }
+
+  Widget _tagPicker(
+    String hint,
+    String? value,
+    List<String> tags,
+    ValueChanged<String?> onChanged,
+  ) => DropdownButton<String>(
+        isExpanded: true,
+        hint: Text(hint),
+        value: tags.contains(value) ? value : null,
+        onChanged: _saving ? null : onChanged,
+        items: [
+          for (final tag in tags)
+            DropdownMenuItem(
+              value: tag,
+              child: Text(tag, overflow: TextOverflow.ellipsis),
+            ),
+        ],
+      );
+}
diff --git a/test/merge_book_tags_test.dart b/test/merge_book_tags_test.dart
