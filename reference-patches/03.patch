+import 'package:openreads/model/book.dart';
+
+int booksFinishedInMonth(Iterable<Book> books, DateTime month) =>
+    books.where((book) {
+      if (book.deleted) return false;
+      return book.readings.any((reading) {
+        final finish = reading.finishDate?.toLocal();
+        return finish != null &&
+            finish.year == month.year &&
+            finish.month == month.month;
+      });
+    }).length;
