+import 'package:flutter/material.dart';
+import 'package:intl/intl.dart';
+import 'package:openreads/core/helpers/monthly_reading_goal.dart';
+import 'package:openreads/model/book.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+class MonthlyReadingGoalCard extends StatefulWidget {
+  const MonthlyReadingGoalCard({super.key, required this.books});
+
+  final List<Book> books;
+
+  @override
+  State<MonthlyReadingGoalCard> createState() => _MonthlyReadingGoalCardState();
+}
+
+class _MonthlyReadingGoalCardState extends State<MonthlyReadingGoalCard> {
+  static const _defaultGoal = 4;
+  static const _preference = 'monthlyBookGoal';
+  final _preferences = SharedPreferencesAsync();
+  late final Future<int> _storedGoal = _loadGoal();
+
+  int? _editedGoal;
+  bool _saving = false;
+
+  Future<int> _loadGoal() async {
+    final goal = await _preferences.getInt(_preference);
+    return goal != null && goal > 0 && goal <= 99 ? goal : _defaultGoal;
+  }
+
+  Future<void> _editGoal(int current) async {
+    final goal = await showDialog<int>(
+      context: context,
+      builder: (_) => _EditMonthlyGoalDialog(initialGoal: current),
+    );
+    if (!mounted || goal == null || goal == current) return;
+    setState(() => _saving = true);
+    try {
+      await _preferences.setInt(_preference, goal);
+      if (mounted) setState(() => _editedGoal = goal);
+    } catch (_) {
+      if (mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(
+          const SnackBar(content: Text('Could not save the monthly goal.')),
+        );
+      }
+    } finally {
+      if (mounted) setState(() => _saving = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final now = DateTime.now();
+    final finished = booksFinishedInMonth(widget.books, now);
+    return FutureBuilder<int>(
+      future: _storedGoal,
+      builder: (context, snapshot) {
+        if (snapshot.connectionState != ConnectionState.done) {
+          return const SizedBox.shrink();
+        }
+        final goal = _editedGoal ?? snapshot.data ?? _defaultGoal;
+        return Card(
+          child: Padding(
+            padding: const EdgeInsets.all(16),
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                Row(
+                  children: [
+                    Expanded(
+                      child: Text('Monthly reading goal',
+                          style: Theme.of(context).textTheme.titleMedium),
+                    ),
+                    TextButton(
+                      onPressed: _saving ? null : () => _editGoal(goal),
+                      child: const Text('Edit goal'),
+                    ),
+                  ],
+                ),
+                Text(DateFormat.yMMMM('en_US').format(now)),
+                const SizedBox(height: 8),
+                LinearProgressIndicator(
+                  value: (finished / goal).clamp(0.0, 1.0).toDouble(),
+                  semanticsLabel: 'Monthly reading goal',
+                  semanticsValue: '$finished of $goal books',
+                ),
+                const SizedBox(height: 8),
+                Text('$finished of $goal books'),
+              ],
+            ),
+          ),
+        );
+      },
+    );
+  }
+}
+
+class _EditMonthlyGoalDialog extends StatefulWidget {
+  const _EditMonthlyGoalDialog({required this.initialGoal});
+
+  final int initialGoal;
+
+  @override
+  State<_EditMonthlyGoalDialog> createState() => _EditMonthlyGoalDialogState();
+}
+
+class _EditMonthlyGoalDialogState extends State<_EditMonthlyGoalDialog> {
+  final _form = GlobalKey<FormState>();
+  late final _controller = TextEditingController(text: '${widget.initialGoal}');
+
+  @override
+  void dispose() {
+    _controller.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return AlertDialog(
+      title: const Text('Edit monthly goal'),
+      content: Form(
+        key: _form,
+        child: TextFormField(
+          autofocus: true,
+          controller: _controller,
+          keyboardType: TextInputType.number,
+          decoration: const InputDecoration(labelText: 'Books per month'),
+          validator: (value) {
+            final number = int.tryParse(value?.trim() ?? '');
+            if (number == null || number < 1 || number > 99) {
+              return 'Enter a whole number from 1 to 99.';
+            }
+            return null;
+          },
+        ),
+      ),
+      actions: [
+        TextButton(
+          onPressed: () => Navigator.of(context).pop(),
+          child: const Text('Cancel'),
+        ),
+        FilledButton(
+          onPressed: () {
+            if (_form.currentState!.validate()) {
+              Navigator.of(context).pop(int.parse(_controller.text.trim()));
+            }
+          },
+          child: const Text('Save'),
+        ),
+      ],
+    );
+  }
+}
